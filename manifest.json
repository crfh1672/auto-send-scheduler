{
  "manifest_version": 3,
  "name": "Auto Send Tool (Long Delay)",
  "version": "1.4",
  "description": "תוסף אוטומציה להפעלת שליחה גם לאחר השהיה ארוכה ברקע",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "alarms",
    "storage",
    "tabs",
    "debugger",
    "background"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}